<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net6.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Platforms>AnyCPU;x64;x86</Platforms>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="NetCoreServer" Version="6.5.0" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.2-beta2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\WorldsAdriftReborn.Storage\WorldsAdriftReborn.Storage.csproj" />

    <!--
      The crew RULES, not the game server. WorldsAdriftRebornGameServer.Multiplayer
      is deliberately dependency-free (no ENet, no game assemblies, no server
      project), so referencing it costs this process nothing and keeps "who may
      boot whom" in one place. The retail Social Sheet drives crews over HTTP -
      see docs/research/findings-social-api.md - so this server and the game
      server mutate the SAME crews, and two copies of those rules would drift.
    -->
    <ProjectReference Include="..\WorldsAdriftRebornGameServer.Multiplayer\WorldsAdriftRebornGameServer.Multiplayer.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!--
      The console's front-end assets: CSS, the shared map renderer's JavaScript
      fragments, and each page's body markup. A GLOB, so adding a fragment (a
      new page, a new panel) needs no csproj edit - see Web/WebAssets.cs for how
      they are composed back into a page.
    -->
    <EmbeddedResource Include="Web\Assets\**\*" />

    <!-- Preserved release MapFile: static geography for the authenticated live map. -->
    <EmbeddedResource Include="..\docs\research\world-data\wamap-islands.json"
                      Link="WorldData\wamap-islands.json" />

    <!--
      The traced object sheets, EMBEDDED RATHER THAN TRANSCRIBED INTO C#.

      This is the tracer's own deliverable, shipped byte for byte, so there is no
      generated source file that can drift from the artwork the way a
      hand-regenerated table can. Two hundred outlines is roughly 700kB of
      coordinates; as C# string literals that is a source file four times the
      size of the largest one in this repository, which every build parses and no
      diff can be read - and it would sit in the assembly as UTF-16, twice the
      size it needs to be. As a resource it is a UTF-8 blob the loader reads once.
      See Emblems/EmblemObjectSheets.cs for the whole of the other end.
    -->
    <EmbeddedResource Include="..\tools\emblem-objects\emblem-objects.json"
                      Link="Emblems\emblem-objects.json" />
  </ItemGroup>

  <ItemGroup>
    <!-- RosterPolicy and friends are internal; the unit tests live outside. -->
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
      <_Parameter1>WorldsAdriftServer.Tests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

</Project>
