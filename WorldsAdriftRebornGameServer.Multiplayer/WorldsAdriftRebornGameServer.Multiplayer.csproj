<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Pure multiplayer policy. Deliberately has NO references: not to ENet, not to
    the game's assemblies, not to the server project. That is what lets these
    types be unit-tested natively on Linux without Wine or a running game.
  -->
  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <!--
    The REAL client entity-prefab census (the same file the tests embed), so the
    RUNTIME server can refuse a station craft whose output prefab the client
    could never load - instead of eating the materials and spawning an entity
    that renders nothing. See ClientEntityPrefabs.
  -->
  <ItemGroup>
    <EmbeddedResource Include="Ship\client-entity-prefabs.txt" />
    <!-- The extracted, TRS-composed LOD0 surface samples for Haven (island
         1431299145): island-local metres + normal, ~2,139 candidate points.
         Embedded so SurfacePlacementGenerator can derive the deterministic
         resource-deposit field from real terrain with no runtime path dependency,
         keeping the assembly dependency-free. Reviewed DATA, diffable in git. -->
    <EmbeddedResource Include="Resources\haven-surface-1431299145.txt" />
    <!-- The 253 AUTHORED STRUCTURE placements on Haven (the ruined metal camp and
         the Saborian brick ruins), island-local metres, projected from
         docs/research/world-data/haven/haven-props-resolved.json. Embedded so a
         placement can be checked against what is ALREADY standing there instead of
         against terrain alone - the miss that drove the Wilderness shrine through
         the metal camp. See HavenStructures. Reviewed DATA, diffable in git. -->
    <EmbeddedResource Include="Resources\haven-structure-props.txt" />
    <EmbeddedResource Include="Resources\trades-challenge-surface-1206286558.txt" />
    <EmbeddedResource Include="Islands\release-runtime-catalog.json" />
    <EmbeddedResource Include="Islands\release-tree-placements.json" />
    <!-- What the ground DOES around each of those tree seats: eight compass
         bearings, one signed decimetre each, so a felled log can be laid along the
         slope instead of flat through it. Generated by
         tools/world-import/generate-tree-ground-profiles.py from the same extracted
         surfaces that chose the seats. Embedded rather than sampled at runtime for
         the reason ReleaseTreeCatalog gives - the surfaces are 45 MB across 255
         files - and it is 8 bytes per seat because the only ground a log ever needs
         is the sixteen metres around the tree it came off. See TreeGroundProfiles
         and LogGrounding. Generated DATA: regenerate, never hand-edit. -->
    <EmbeddedResource Include="Islands\release-tree-ground-profiles.txt" />
    <!-- Loot-container seats for all 254 release islands, generated offline by
         tools/world-import/generate-release-loot-placements.py from each island's
         measured surface, using retail's own recovered area budget and 20 m
         spacing rule. See ReleaseLootCatalog. -->
    <EmbeddedResource Include="Islands\release-loot-placements.json" />
    <!-- The tier-keyed scrap table loot containers draw from, projected out of
         Game/Items/Config/itemData.json by
         tools/world-import/generate-loot-scrap-tiers.py. Embedded rather than read
         from that file because this assembly references nothing, which is what
         lets the loot roll be unit-tested with no game install.
         LootScrapTableIntegrityTests re-reads itemData.json and asserts the two
         still agree. Reviewed DATA, diffable in git. See LootScrapTable. -->
    <EmbeddedResource Include="Loot\loot-scrap-tiers.txt" />
    <!-- The release map's 44 weather walls as endpoint pairs, projected out of
         docs/research/world-data/wamap-islands.json#Walls by
         tools/world-import/generate-release-wall-segments.py. That IS the complete
         retail payload for a wall - WorldEditorWallData.WallStoreData carried
         {x1,z1,x2,z2,Type} and no tuning at all - so there is nothing here to tune
         and nothing missing. The midpoint/direction/HALF-length arithmetic that
         turns these into 1204 WallSegmentState deliberately lives in C#
         (WallCatalog), where it is unit-tested, rather than baked in here.
         Generated DATA: regenerate, never hand-edit. -->
    <EmbeddedResource Include="Walls\release-wall-segments.json" />
  </ItemGroup>

</Project>
