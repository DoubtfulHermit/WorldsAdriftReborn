<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The player-facing patcher. Ships as ONE self-contained win-x64 .exe so a
    player needs no .NET install: double-click, point it at the game folder,
    patch. WinForms for the tiny GUI the user asked for; a console path drives
    the identical PatchEngine headless for the Wine smoke test.

    See tools/patcher/README.md for the exact publish command.
  -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <!-- Required to build a Windows-targeted (WinForms) project from Linux. -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <!-- Trimming off: WinForms + reflection-based JSON do not trim cleanly, and
         the size win is not worth a runtime surprise on a player's machine. -->
    <PublishTrimmed>false</PublishTrimmed>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>

    <AssemblyName>WAPatch</AssemblyName>
    <Version>1.1.0</Version>
    <Product>Worlds Adrift Reborn Patcher</Product>
  </PropertyGroup>

</Project>
